<Project Sdk="Microsoft.NET.Sdk">

  <!--
    エンドツーエンドで動くサンプル。docs/ から参照される「模倣対象」であり、
    ビルド対象なので腐らない。

    net8.0 単一ターゲット。ライブラリ本体は net8.0;net10.0 のマルチターゲットだが、
    サンプルは `dotnet run` を引数なしで通したいので 1 つに絞っている。
    LangVersion / Nullable / TreatWarningsAsErrors は Directory.Build.props から継承する。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CSStack.TADA.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NuGet から使う場合はこの ProjectReference の代わりに
      <PackageReference Include="CSStack.TADA" Version="3.0.0" /> を書く。
    -->
    <ProjectReference Include="..\..\src\CSStack.TADA\CSStack.TADA.csproj" />
  </ItemGroup>

</Project>
