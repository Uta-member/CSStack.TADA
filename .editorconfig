# EditorConfig — https://editorconfig.org
#
# CLAUDE.md のコーディング規約を機械的に強制するための設定。
# 規約を変えるときは CLAUDE.md とこのファイルの両方を更新すること。
#
# 注意: 既存ファイルの一括再フォーマットはこのファイルの追加とは別コミットにする。

root = true

###############################################################################
# 全ファイル共通
#
# 改行コード: .gitattributes の `* text=auto eol=crlf` により、リポジトリ内では
# LF に正規化しつつチェックアウト時は OS を問わず CRLF に変換される。よって
# ここでの crlf は Windows のローカルでも Linux の CI でも成立する。
# コミット時に git が LF へ戻すため差分は生じない。
###############################################################################

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

###############################################################################
# Markdown
#
# .md は BOM なし（上の charset = utf-8 のまま）。
# 行末の 2 スペースが強制改行の意味を持つため trim_trailing_whitespace は無効。
###############################################################################

[*.md]
trim_trailing_whitespace = false

###############################################################################
# プロジェクトファイル・設定ファイル
###############################################################################

[*.{csproj,props,targets,config,nuspec,resx,ruleset,xml}]
indent_size = 2

# .csproj と .sln は Visual Studio が BOM 付きで書き戻すため、それに合わせる。
# Directory.Build.props など VS が触らないファイルは BOM なしのまま。
[*.{csproj,sln}]
charset = utf-8-bom

[*.{yml,yaml,json}]
indent_size = 2

[*.sln]
indent_style = tab

###############################################################################
# C#
#
# .cs は UTF-8 BOM 付き（既存ファイルはすべて BOM 付き）。
# インデントは src/ がタブ。tests/ は既存に合わせてスペース 4（後述で上書き）。
###############################################################################

[*.cs]
charset = utf-8-bom
indent_style = tab
tab_width = 4

#### namespace ####

# namespace は Domain/ UseCase/ などのフォルダ構成を反映せず、すべて
# `CSStack.TADA` にフラットに置く。利用者が `using CSStack.TADA;` だけで
# 済むようにするための意図的な設計。`CSStack.TADA.Domain` とは書かない。
dotnet_style_namespace_match_folder = false:silent

# file-scoped ではなくブロックスコープの namespace を使う。
csharp_style_namespace_declarations = block_scoped:warning

#### using ディレクティブ ####

csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_prefer_utf8_string_literals = true:silent

#### this. 修飾 ####

dotnet_style_qualification_for_event = false:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_property = false:warning

#### 型宣言 ####

dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
csharp_style_var_elsewhere = true:silent
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent

#### 波かっこ・改行 ####

# Allman スタイル。既存コードはすべてこの形。
csharp_new_line_before_open_brace = all
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true

# 1 行でも波かっこを省略しない。
csharp_prefer_braces = true:warning

#### 式・パターン ####

csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

#### readonly / 不変性 ####

dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

#### 命名規則 ####

# private / internal フィールドは _camelCase（既存コードの慣習）。
dotnet_naming_rule.private_fields_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_internal_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# インターフェースは I 接頭辞。
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# 型とフィールド以外のメンバーは PascalCase。
dotnet_naming_rule.types_and_members_pascal_case.severity = warning
dotnet_naming_rule.types_and_members_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal_case.style = pascal_case

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, property, method, event, delegate, type_parameter
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

# パラメーターとローカル変数は camelCase。
dotnet_naming_rule.parameters_and_locals_camel_case.severity = warning
dotnet_naming_rule.parameters_and_locals_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_camel_case.style = camel_case

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_symbols.parameters_and_locals.applicable_accessibilities = *

dotnet_naming_style.camel_case.capitalization = camel_case

#### XML doc ####

# 公開メンバーの XML doc は必須（GenerateDocumentationFile が有効）。
# 特に CS1570 / CS1574 の破損はレビューで見落とされやすいため明示しておく。
# Directory.Build.props の TreatWarningsAsErrors により、これらはビルドを失敗させる。

# XML コメントの XML が不正
dotnet_diagnostic.CS1570.severity = warning
# param タグの重複
dotnet_diagnostic.CS1571.severity = warning
# 存在しないパラメーターの param タグ
dotnet_diagnostic.CS1572.severity = warning
# param タグの記述漏れ
dotnet_diagnostic.CS1573.severity = warning
# cref を解決できない
dotnet_diagnostic.CS1574.severity = warning
# 不正な param 参照
dotnet_diagnostic.CS1580.severity = warning
# 不正な return 型参照
dotnet_diagnostic.CS1581.severity = warning
# 不正な cref 構文
dotnet_diagnostic.CS1584.severity = warning
# 公開メンバーに XML doc が無い
dotnet_diagnostic.CS1591.severity = warning
# typeparam タグの重複
dotnet_diagnostic.CS1710.severity = warning
# 存在しない型引数の typeparam タグ
dotnet_diagnostic.CS1711.severity = warning
# typeparam タグの記述漏れ
dotnet_diagnostic.CS1712.severity = warning

###############################################################################
# テストコード・サンプルコード
#
# tests/ は既存ファイルに合わせてスペース 4。src/ のタブとは意図的に別。
# samples/ も同じスペース 4。ライブラリ本体ではなく「利用者が書くコード」の
# 見本であり、本体のタブ規約を利用者に押しつけないため。
###############################################################################

[tests/**.cs]
indent_style = space
indent_size = 4

[samples/**.cs]
indent_style = space
indent_size = 4

# サンプルは名前空間 CSStack.TADA.Sample を使う（本体のフラット namespace 規約の
# 対象外）。フォルダ構成もレイヤーを示すためにあり、namespace には反映しない。
